<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        FALSE POSITIVE: spring-boot-starter-thymeleaf
        NVD assigns CPE cpe:2.3:a:thymeleaf:thymeleaf:3.5.0 to this artifact because
        the JAR filename contains "3.5.0". The actual Thymeleaf engine bundled is
        3.1.3.RELEASE — the starter JAR itself contains only Spring Boot auto-config
        metadata, not Thymeleaf code.
    -->
    <suppress>
        <notes>CPE mismatch: starter-thymeleaf is not Thymeleaf 3.5.0; actual Thymeleaf jar is 3.1.3.RELEASE</notes>
        <gav regex="true">^org\.springframework\.boot:spring-boot-starter-thymeleaf:.*$</gav>
        <cpe>cpe:/a:thymeleaf:thymeleaf:3.5.0</cpe>
    </suppress>

    <!--
        FALSE POSITIVE: spring-boot-starter-web
        NVD assigns CPE cpe:2.3:a:web_project:web:3.5.0 based on the artifact name.
        This is a Spring Boot starter JAR, not the "web_project:web" product.
    -->
    <suppress>
        <notes>CPE mismatch: spring-boot-starter-web is not web_project:web</notes>
        <gav regex="true">^org\.springframework\.boot:spring-boot-starter-web:.*$</gav>
        <cpe>cpe:/a:web_project:web:3.5.0</cpe>
    </suppress>

    <!--
        FALSE POSITIVE: spring-boot-starter-* CVE over-match
        CVEs CVE-2026-22731, CVE-2026-22733, CVE-2026-40972/73/75/77 are matched
        via the broad cpe:2.3:a:vmware:spring_boot CPE applied to every Spring Boot
        artifact. The vulnerable code lives in spring-boot-3.5.0.jar (core), not in
        starter JARs which contain only @Configuration and auto-config metadata.
        The fix is to upgrade spring-boot core when a patched version is released.
    -->
    <suppress>
        <notes>CPE over-match on starter JAR: vulnerable code is in spring-boot core, not this starter</notes>
        <gav regex="true">^org\.springframework\.boot:spring-boot-starter-thymeleaf:.*$</gav>
        <cve>CVE-2026-22731</cve>
        <cve>CVE-2026-22733</cve>
        <cve>CVE-2026-40972</cve>
        <cve>CVE-2026-40973</cve>
        <cve>CVE-2026-40975</cve>
        <cve>CVE-2026-40977</cve>
    </suppress>
    <suppress>
        <notes>CPE over-match on starter JAR: vulnerable code is in spring-boot core, not this starter</notes>
        <gav regex="true">^org\.springframework\.boot:spring-boot-starter-web:.*$</gav>
        <cve>CVE-2026-22731</cve>
        <cve>CVE-2026-22733</cve>
        <cve>CVE-2026-40972</cve>
        <cve>CVE-2026-40973</cve>
        <cve>CVE-2026-40975</cve>
        <cve>CVE-2026-40977</cve>
    </suppress>

    <!--
        FALSE POSITIVE: spring-security-web CVE-2026-22746/22748/22751
        These CVEs match spring-security-web via cpe:2.3:a:web_project:web CPE
        (same filename-based mismatch as spring-boot-starter-web above).
        The actual Spring Security CVE-2026-22732 (9.1) is real and NOT suppressed.
    -->
    <suppress>
        <notes>CPE mismatch: spring-security-web matched as web_project:web — wrong product</notes>
        <gav regex="true">^org\.springframework\.security:spring-security-web:.*$</gav>
        <cpe>cpe:/a:web_project:web</cpe>
    </suppress>

</suppressions>
