pipeline{
    agent any

    tools {
        maven 'maven'
        jdk 'java-17'
    }

    environment{
        IMAGE_NAME = "manojkrishnappa/snakegame:${GIT_COMMIT}"
        AWS_REGION = "ap-northeast-1"
        CLUSTER_NAME = "Shab-Cluster"
        NAMESPACE = "shab"
    }

    stages{
        stage('compile'){
            steps{
                sh '''
                echo 'Compiling the code...'
                mvn compile
                '''
            }
        }

        stage('Code coverage'){
            steps{
                sh '''
                echo 'Generating code coverage report...'
                mvn clean test jacoco:report
                '''
            }

            post {
                always {
                    jacoco execPattern: '**/target/jacoco.exec', classPattern: '**/target/classes', sourcePattern: '**/src/main/java'
                }
            }
        }


       stage('sonarQube-authentication'){
            steps{
                withSonarQubeEnv('SonarQube') {
                    sh '''
                    echo 'Running SonarQube analysis...'
                    mvn clean package org.sonarsource.scanner.maven:sonar-maven-plugin:sonar
                    '''
                }
            }
       }

        stage('Quality Gate'){
            steps{
                timeout(time: 1, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }


        stage('Base-image-scan'){
            steps{
                sh '''
                echo 'Running base image scan for vulnerabilities...'
                bash trivy-docker-image-scan.sh
                '''
            }
        }

        stage('Build-Docker-image'){
                    steps{
                        sh '''
                        echo 'Building Docker image...'
                        docker build -t $IMAGE_NAME .
                        '''
                    }
        }

